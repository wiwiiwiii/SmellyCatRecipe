page {
  min-height: 100vh;
  background: #17110e;
  color: #f8ead8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

button {
  border-radius: 999rpx;
  padding: 0;
}

button::after {
  border: 0;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

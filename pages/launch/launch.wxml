<view class="page">
  <view class="panel">
    <image class="logo" src="/static/img/logo.jpg" mode="aspectFill" />
    <view class="eyebrow">{{appEnglishName}}</view>
    <view class="title">{{appName}}</view>
    <view class="status">{{status}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button wx:if="{{error}}" class="retry" bindtap="routeByWechatIdentity">再试一次</button>
  </view>
</view>

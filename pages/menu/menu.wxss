.page {
  min-height: 100vh;
  padding: 28rpx;
  background: radial-gradient(circle at 90% 0%, rgba(242, 166, 90, 0.18), transparent 36%), #17110e;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2b2019 0%, #17110e 100%);
  border: 1rpx solid rgba(242, 166, 90, 0.26);
  box-shadow: 0 18rpx 50rpx rgba(0, 0, 0, 0.28);
}

.hero-logo {
  position: absolute;
  right: -42rpx;
  top: -52rpx;
  width: 240rpx;
  height: 240rpx;
  opacity: 0.18;
  border-radius: 48rpx;
}

.hero-kicker {
  position: relative;
  font-size: 24rpx;
  font-weight: 700;
  color: #f2a65a;
}

.hero-title {
  position: relative;
  margin-top: 12rpx;
  max-width: 520rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #f8ead8;
  letter-spacing: 0;
}

.hero-subtitle {
  position: relative;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #c9aa8d;
}

.dev-owner-link {
  position: relative;
  width: 180rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 24rpx 0 0;
  background: rgba(242, 166, 90, 0.14);
  color: #ffd3a1;
  font-size: 24rpx;
  font-weight: 700;
}

.section {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #241b16;
  border: 1rpx solid rgba(242, 166, 90, 0.18);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.18);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 750;
  color: #f8ead8;
}

.section-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #c9aa8d;
}

.selected-pill {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(242, 166, 90, 0.14);
  color: #ffd3a1;
  font-size: 24rpx;
  font-weight: 650;
}

.chip-scroll {
  display: flex;
  margin-top: 24rpx;
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  margin-right: 16rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #30231c;
  color: #c9aa8d;
  font-size: 26rpx;
}

.chip-active {
  background: #f2a65a;
  color: #17110e;
  font-weight: 800;
}

.mood-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.mood-chip {
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 20rpx;
  background: #30231c;
  color: #c9aa8d;
  font-size: 25rpx;
}

.mood-chip-active {
  background: rgba(242, 166, 90, 0.18);
  color: #ffd3a1;
  border: 1rpx solid rgba(242, 166, 90, 0.45);
}

.search-input,
.wish-input {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #17110e;
  color: #f8ead8;
  font-size: 27rpx;
}

.wish-prompt {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(242, 166, 90, 0.12);
  border: 1rpx dashed rgba(242, 166, 90, 0.42);
}

.wish-title {
  color: #ffd3a1;
  font-size: 27rpx;
  font-weight: 750;
}

.wish-button {
  height: 68rpx;
  line-height: 68rpx;
  margin-top: 18rpx;
  background: #f2a65a;
  color: #17110e;
  font-size: 26rpx;
  font-weight: 800;
}

.wish-list {
  margin-top: 18rpx;
}

.wish-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 211, 161, 0.12);
}

.wish-item-name {
  color: #f8ead8;
  font-size: 28rpx;
  font-weight: 750;
}

.wish-item-note {
  margin-top: 6rpx;
  color: #c9aa8d;
  font-size: 24rpx;
}

.wish-remove {
  flex: none;
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: #30231c;
  color: #c9aa8d;
  font-size: 23rpx;
}

.dish-list {
  margin-top: 28rpx;
}

.dish-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid rgba(242, 166, 90, 0.14);
  border-radius: 24rpx;
  background: #241b16;
}

.dish-card-selected {
  border-color: #f2a65a;
  background: #30231c;
}

.dish-content {
  flex: 1;
}

.dish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 750;
  color: #f8ead8;
}

.dish-reason {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #ffd3a1;
}

.dish-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #c9aa8d;
}

.dish-tags {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #f2a65a;
}

.dish-time {
  flex: none;
  font-size: 23rpx;
  color: #c9aa8d;
}

.dish-check {
  flex: none;
  min-width: 92rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: #f2a65a;
  color: #17110e;
  font-size: 23rpx;
  text-align: center;
  font-weight: 800;
}

.note-input {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #17110e;
  color: #f8ead8;
  font-size: 27rpx;
  line-height: 1.5;
}

.submit-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #f2a65a;
  color: #17110e;
}

.submit-title {
  font-size: 28rpx;
  font-weight: 750;
}

.submit-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #5b341c;
}

.submit-button {
  flex: none;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 30rpx;
  background: #17110e;
  color: #ffd3a1;
  font-size: 27rpx;
  font-weight: 750;
}

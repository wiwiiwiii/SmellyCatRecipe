.page {
  min-height: 100vh;
  padding: 28rpx;
  background: radial-gradient(circle at 12% 0%, rgba(242, 166, 90, 0.18), transparent 34%), #17110e;
}

.hero,
.section,
.menu-card,
.empty-card {
  border-radius: 28rpx;
  background: #241b16;
  border: 1rpx solid rgba(242, 166, 90, 0.18);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.16);
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #30231c 0%, #17110e 100%);
  border-color: rgba(242, 166, 90, 0.24);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.24);
}

.hero-logo {
  position: absolute;
  right: -34rpx;
  top: -48rpx;
  width: 220rpx;
  height: 220rpx;
  opacity: 0.16;
  border-radius: 44rpx;
}

.hero-kicker,
.visibility-pill,
.menu-tags,
.field-label {
  color: #f2a65a;
}

.hero-kicker {
  position: relative;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  position: relative;
  margin-top: 12rpx;
  max-width: 520rpx;
  color: #f8ead8;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-subtitle {
  position: relative;
  margin-top: 12rpx;
  color: #c9aa8d;
  font-size: 27rpx;
  line-height: 1.45;
}

.cat-link {
  position: relative;
  width: 180rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 24rpx 0 0;
  background: rgba(242, 166, 90, 0.14);
  color: #ffd3a1;
  font-size: 24rpx;
  font-weight: 700;
}

.section,
.empty-card {
  margin-top: 28rpx;
  padding: 28rpx;
}

.section-head,
.menu-head,
.menu-actions {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title,
.menu-title,
.empty-title {
  color: #f8ead8;
  font-weight: 750;
}

.section-title {
  font-size: 32rpx;
}

.section-note,
.menu-desc,
.menu-meta,
.empty-note {
  color: #c9aa8d;
}

.section-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.text-input,
.textarea-input {
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #17110e;
  color: #f8ead8;
  font-size: 27rpx;
}

.text-input {
  height: 78rpx;
}

.textarea-input {
  min-height: 138rpx;
  padding-top: 20rpx;
  line-height: 1.45;
}

.field-label {
  margin-top: 22rpx;
  font-size: 25rpx;
  font-weight: 750;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.chip {
  width: auto;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #30231c;
  color: #c9aa8d;
  font-size: 24rpx;
}

.mood-chip {
  border-radius: 20rpx;
}

.chip-active {
  background: #f2a65a;
  color: #17110e;
  font-weight: 800;
}

.primary-button,
.ghost-button,
.small-button {
  font-weight: 800;
}

.primary-button,
.ghost-button {
  height: 78rpx;
  line-height: 78rpx;
  margin-top: 22rpx;
  font-size: 27rpx;
}

.primary-button {
  background: #f2a65a;
  color: #17110e;
}

.ghost-button,
.small-button {
  background: #30231c;
  color: #ffd3a1;
}

.small-button {
  width: auto;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  font-size: 23rpx;
}

.menu-list {
  margin-top: 28rpx;
}

.menu-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.menu-card-hidden {
  opacity: 0.72;
}

.menu-title {
  font-size: 30rpx;
}

.menu-meta,
.menu-desc,
.menu-reason,
.menu-tags {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.menu-reason {
  color: #ffd3a1;
}

.visibility-pill {
  flex: none;
  max-width: 180rpx;
  font-size: 23rpx;
  line-height: 1.35;
  text-align: right;
}

.menu-actions {
  justify-content: flex-start;
  margin-top: 20rpx;
}

.empty-card {
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
}

.empty-note {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  background: radial-gradient(circle at 12% 0%, rgba(242, 166, 90, 0.18), transparent 34%), #17110e;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #30231c 0%, #17110e 100%);
  border: 1rpx solid rgba(242, 166, 90, 0.24);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.24);
}

.hero-logo {
  position: absolute;
  right: -34rpx;
  top: -48rpx;
  width: 220rpx;
  height: 220rpx;
  opacity: 0.16;
  border-radius: 44rpx;
}

.hero-kicker,
.order-status,
.wish-title,
.note-label {
  color: #f2a65a;
}

.hero-kicker {
  position: relative;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  position: relative;
  margin-top: 12rpx;
  max-width: 520rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: #f8ead8;
  letter-spacing: 0;
}

.hero-subtitle {
  position: relative;
  margin-top: 12rpx;
  color: #c9aa8d;
  font-size: 27rpx;
  line-height: 1.45;
}

.cat-link {
  position: relative;
  width: 180rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 24rpx 0 0;
  background: rgba(242, 166, 90, 0.14);
  color: #ffd3a1;
  font-size: 24rpx;
  font-weight: 700;
}

.order-list {
  margin-top: 28rpx;
}

.order-card,
.section,
.empty-card {
  border-radius: 28rpx;
  background: #241b16;
  border: 1rpx solid rgba(242, 166, 90, 0.18);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.16);
}

.order-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.order-card-active {
  border-color: #f2a65a;
  background: #30231c;
}

.order-card-head,
.section-head,
.order-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.order-card-head,
.section-head {
  align-items: flex-start;
}

.order-title,
.section-title,
.dish-name {
  color: #f8ead8;
  font-weight: 750;
}

.order-title {
  font-size: 30rpx;
}

.order-items,
.section-note,
.dish-desc,
.note-text,
.order-time {
  color: #c9aa8d;
}

.order-items {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.45;
}

.order-status {
  flex: none;
  max-width: 220rpx;
  font-size: 23rpx;
  line-height: 1.35;
  text-align: right;
}

.order-side {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.unread-badge,
.detail-unread {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e85d3f;
  color: #fff8ef;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-unread {
  margin-top: 14rpx;
}

.order-time {
  margin-top: 16rpx;
  font-size: 21rpx;
}

.section {
  margin-top: 28rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 32rpx;
}

.section-note {
  margin-top: 8rpx;
  color: #ffd3a1;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.meal-pill {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(242, 166, 90, 0.14);
  color: #ffd3a1;
  font-size: 24rpx;
  font-weight: 700;
}

.order-item {
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 211, 161, 0.12);
}

.order-item:last-child {
  border-bottom: 0;
}

.dish-name {
  font-size: 29rpx;
}

.dish-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.dish-count {
  flex: none;
  color: #f2a65a;
  font-size: 24rpx;
}

.wish-block,
.note-box {
  margin-top: 18rpx;
}

.wish-title,
.note-label {
  font-size: 25rpx;
  font-weight: 750;
}

.note-box {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #17110e;
}

.note-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.primary-button {
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 24rpx;
  background: #f2a65a;
  color: #17110e;
  font-size: 28rpx;
  font-weight: 800;
}

.done-note {
  margin-top: 22rpx;
  color: #ffd3a1;
  font-size: 25rpx;
}

.empty-card {
  margin-top: 28rpx;
  padding: 42rpx 32rpx;
  text-align: center;
}

.empty-title {
  color: #f8ead8;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-note {
  margin-top: 16rpx;
  color: #c9aa8d;
  font-size: 26rpx;
}

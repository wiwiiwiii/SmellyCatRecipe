.page {
  min-height: 100vh;
  padding: 28rpx;
  background: radial-gradient(circle at 10% 0%, rgba(242, 166, 90, 0.18), transparent 34%), #17110e;
}

.status-card {
  position: relative;
  overflow: hidden;
  padding: 42rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #3a291f 0%, #17110e 100%);
  color: #f8ead8;
  border: 2rpx solid rgba(242, 166, 90, 0.46);
  box-shadow: 0 22rpx 56rpx rgba(0, 0, 0, 0.3);
}

.status-logo {
  position: absolute;
  right: -34rpx;
  top: -48rpx;
  width: 220rpx;
  height: 220rpx;
  opacity: 0.16;
  border-radius: 44rpx;
}

.status-label {
  position: relative;
  color: #f2a65a;
  font-size: 24rpx;
  font-weight: 800;
}

.status-title {
  position: relative;
  margin-top: 16rpx;
  max-width: 520rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.status-subtitle {
  position: relative;
  margin-top: 12rpx;
  color: #ffd3a1;
  font-size: 29rpx;
  line-height: 1.45;
}

.unread-badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: #e85d3f;
  color: #fff8ef;
  font-size: 23rpx;
  font-weight: 800;
}

.section {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #241b16;
  border: 1rpx solid rgba(242, 166, 90, 0.18);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.16);
}

.replacement-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #30231c;
  border: 2rpx solid rgba(242, 166, 90, 0.42);
  box-shadow: 0 14rpx 44rpx rgba(0, 0, 0, 0.22);
}

.replacement-title {
  color: #f8ead8;
  font-size: 32rpx;
  font-weight: 800;
}

.replacement-items {
  margin-top: 12rpx;
  color: #f2a65a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.replacement-reason {
  margin-top: 12rpx;
  color: #c9aa8d;
  font-size: 25rpx;
  line-height: 1.5;
}

.replacement-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.section-title {
  color: #f8ead8;
  font-size: 32rpx;
  font-weight: 750;
}

.section-note {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  color: #c9aa8d;
  font-size: 25rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 211, 161, 0.12);
}

.order-item:last-child {
  border-bottom: 0;
}

.dish-name {
  color: #f8ead8;
  font-size: 29rpx;
  font-weight: 750;
}

.dish-desc {
  margin-top: 8rpx;
  color: #c9aa8d;
  font-size: 24rpx;
  line-height: 1.45;
}

.dish-time {
  flex: none;
  color: #f2a65a;
  font-size: 24rpx;
}

.wish-block {
  margin-top: 16rpx;
}

.wish-title {
  color: #ffd3a1;
  font-size: 26rpx;
  font-weight: 750;
}

.note {
  margin-top: 16rpx;
  color: #c9aa8d;
  font-size: 27rpx;
  line-height: 1.5;
}

.warning-box {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(242, 166, 90, 0.12);
  color: #ffd3a1;
  font-size: 25rpx;
}

.message-box {
  margin-top: 28rpx;
  padding: 26rpx;
  border: 2rpx dashed rgba(242, 166, 90, 0.42);
  border-radius: 24rpx;
  background: #241b16;
  color: #c9aa8d;
  font-size: 25rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.primary-button,
.ghost-button {
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 750;
}

.primary-button {
  background: #f2a65a;
  color: #17110e;
}

.ghost-button {
  background: #30231c;
  color: #ffd3a1;
}

.compact-button {
  flex: 1 1 250rpx;
  min-width: 0;
  margin-top: 0;
  padding: 0 18rpx;
  font-size: 26rpx;
}

.empty-card {
  margin-top: 160rpx;
  padding: 42rpx 32rpx;
  border-radius: 32rpx;
  background: #241b16;
  text-align: center;
  border: 1rpx solid rgba(242, 166, 90, 0.18);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.16);
}

.empty-title {
  color: #f8ead8;
  font-size: 36rpx;
  font-weight: 800;
}

.empty-note {
  margin: 18rpx 0 20rpx;
  color: #c9aa8d;
  font-size: 26rpx;
}
